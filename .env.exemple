# Copie ce fichier en « .env » (meme dossier) et remplis les valeurs.
# Le fichier .env est ignore par Git : aucun identifiant ne part dans le depot.

# --- Envoi du rapport par courriel ---------------------------------------------
# Gmail refuse le mot de passe du compte : cree un mot de passe d'application sur
# https://myaccount.google.com/apppasswords (16 caracteres, espaces autorises).
BETBOT_MAIL_HOST=smtp.gmail.com
BETBOT_MAIL_PORT=587
BETBOT_MAIL_USER=kaelmi@gmail.com
BETBOT_MAIL_PASSWORD=
BETBOT_MAIL_TO=kaelmi@gmail.com

# --- Publication WordPress ------------------------------------------------------
# Mot de passe d'application WordPress : Utilisateurs > Profil > Mots de passe
# d'application. Le mot de passe du compte ne fonctionne pas sur l'API REST.
BETBOT_WP_SITE=https://maythayus1.store
BETBOT_WP_USER=
BETBOT_WP_PASSWORD=
# draft (brouillon, recommande), publish ou private.
BETBOT_WP_STATUS=draft
